# ========================================
# GOOGLE CLOUD CONFIGURATION
# ========================================

# Path to your service account key (never commit this file)
GOOGLE_APPLICATION_CREDENTIALS=service-account-key.json

# Your Google Cloud project ID
PROJECT_ID=your-project-id

# Vertex AI location (current Gemini models require "global")
LOCATION=global

# Alternative: use a Gemini API key instead of Vertex AI
# GOOGLE_API_KEY=your-api-key

# ========================================
# MODEL CONFIGURATION
# ========================================

# Gemini model used by all agents
MODEL_NAME=gemini-3.5-flash-lite

# Stricter model for the research critic (defaults to MODEL_NAME)
CRITIC_MODEL=gemini-3.5-flash

# ========================================
# RESEARCH SETTINGS
# ========================================

# Maximum iterations for the research refinement loop
MAX_ITERATIONS=3

# Critic score (0.0-1.0) required to stop refining
QUALITY_THRESHOLD=0.95

# ========================================
# CUSTOM RESEARCH QUERY (Optional)
# ========================================

# RESEARCH_QUERY=How has CRISPR gene editing changed crop breeding in agriculture?
